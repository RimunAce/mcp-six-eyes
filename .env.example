# Primary vision backend: openai | anthropic | google | openrouter | custom
VISION_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Google Gemini ---
# GOOGLE_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# --- OpenRouter (OpenAI-compatible) ---
# OPENROUTER_API_KEY=...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Custom OpenAI-compatible endpoint ---
# VISION_PROVIDER=custom
# VISION_API_KEY=...
# VISION_BASE_URL=https://your-endpoint/v1
# VISION_MODEL=your-vision-model

# Optional overrides
# VISION_MODEL=gpt-4o
# VISION_TIMEOUT_MS=60000
# VISION_MAX_IMAGE_BYTES=20971520
# VISION_MAX_IMAGES=10
# VISION_CACHE_MAX_ENTRIES=200   # 0 disables the response cache

# Optional fallback provider if primary fails
# VISION_FALLBACK_PROVIDER=anthropic
# VISION_FALLBACK_MODEL=claude-sonnet-4-5
