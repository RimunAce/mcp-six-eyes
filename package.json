{
  "name": "mcp-six-eyes",
  "version": "1.1.0",
  "description": "MCP server that gives text-only AI agents image understanding via vision APIs",
  "type": "module",
  "bin": {
    "mcp-six-eyes": "./build/index.js"
  },
  "files": [
    "build",
    "assets",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "test:unit": "node --test \"test/**/*.test.mjs\"",
    "smoke": "npm run build && node scripts/smoke-load.mjs",
    "release": "node scripts/deploy-release.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vision",
    "image",
    "ocr",
    "multimodal",
    "six-eyes",
    "npx",
    "claude",
    "cursor",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RimunAce/mcp-six-eyes.git"
  },
  "bugs": {
    "url": "https://github.com/RimunAce/mcp-six-eyes/issues"
  },
  "homepage": "https://github.com/RimunAce/mcp-six-eyes#readme",
  "author": "RimunAce",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
